<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Embedded into the audio-capture helper binary via -sectcreate __TEXT __info_plist
  (see scripts/build-audio-helper.sh). A bare helper executable has no bundle, so
  without this TCC cannot identify it or find a usage string when macOS attributes
  the CoreAudio process-tap permission check to the helper itself (observed on
  macOS 26: tap returns noErr but delivers zero frames — silent denial).
-->
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key>
  <string>ai.livetranscript.audio-capture</string>
  <key>CFBundleName</key>
  <string>LiveTranscript Audio Capture</string>
  <key>NSAudioCaptureUsageDescription</key>
  <string>LiveTranscript captures your computer's audio output to transcribe what's playing (e.g. a meeting), without touching your microphone.</string>
</dict>
</plist>
