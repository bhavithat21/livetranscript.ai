{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LiveTranscript",
  "version": "0.1.0",
  "identifier": "ai.livetranscript.desktop",
  "build": {
    "frontendDist": "https://livetranscript.ai"
  },
  "app": {
    "windows": [
      {
        "title": "LiveTranscript",
        "width": 1200,
        "height": 800,
        "minWidth": 380,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
