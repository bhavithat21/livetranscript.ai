# Copy to .env.local and fill in your own values. NEVER commit real keys.
# .env.local is gitignored. Placeholders below show the expected format only.

# --- Auth (Clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Speech-to-text ---
DEEPGRAM_API_KEY=your_deepgram_api_key
ASSEMBLYAI_API_KEY=your_assemblyai_api_key   # optional (higher-accuracy engine)

# --- Correction, summaries & copilot ---
OPENAI_API_KEY=sk-your_openai_api_key        # optional
# Copilot per-purpose models (optional overrides; same OpenAI key). Defaults:
#   fast  = gpt-4o-mini  (router / behavioral / general — latency-critical)
#   smart = gpt-4o       (coding / system design / screen vision — correctness-first)
# COPILOT_MODEL_FAST=gpt-4o-mini
# COPILOT_MODEL_SMART=gpt-4o

# Optional Jev classification of ambiguous utterances; clear cases remain local.
# Disabled unless explicitly selected. Server-only: never use NEXT_PUBLIC_ keys.
# COPILOT_CLASSIFIER_PROVIDER=jev
# TYPESAFE_API_KEY=your_typesafe_api_key
# TYPESAFE_MODEL=jev-latest
# Jev failure/uncertainty falls back to the existing Groq/OpenAI JSON classifier.
# COPILOT_CLASSIFIER_MODEL=llama-3.3-70b-versatile

# --- Repository screenshots and specialist agents ---
# Required for Claude screenshot extraction and the default repository agents.
ANTHROPIC_API_KEY=your_anthropic_api_key
# Optional when routing a text specialist to a Groq-hosted model.
# GROQ_API_KEY=your_groq_api_key
# Defaults are operational choices, not measured benchmark winners.
# COPILOT_REPO_MODEL_VISION=claude-sonnet-5
# COPILOT_REPO_MODEL_REQUIREMENTS=claude-sonnet-5
# COPILOT_REPO_MODEL_IMPLEMENTATION=claude-sonnet-5
# COPILOT_REPO_MODEL_DEBUGGER=claude-sonnet-5
# COPILOT_REPO_MODEL_REVIEWER=claude-sonnet-5
# COPILOT_REPO_MODEL_SYNTHESIS=claude-sonnet-5
# Shared production/benchmark generation settings; changing them requires remeasurement.
# COPILOT_REPO_MAX_OUTPUT_TOKENS=8192
# COPILOT_REPO_REASONING_EFFORT=low
# Reviewed benchmark routing: see evals/repo/README.md.
# COPILOT_REPO_BENCHMARK_POLICY=

# --- Realtime meeting rooms (Ably) ---
ABLY_API_KEY=your_ably_key:secret

# --- Database (Neon Postgres) ---
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Desktop installer download URLs --- optional (unset => "Coming soon")
# Point at the signed .dmg/.exe wherever hosted (Vercel Blob public URL, CDN, etc.)
# NEXT_PUBLIC_DOWNLOAD_MAC_URL=https://<blob-host>/LiveTranscript.dmg
# NEXT_PUBLIC_DOWNLOAD_WIN_URL=https://<blob-host>/LiveTranscript-setup.exe

# --- Analytics (PostHog) --- optional
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxx
POSTHOG_HOST=https://us.i.posthog.com

# --- Access control / billing --- optional
OWNER_USER_IDS=user_xxx,user_yyy   # Clerk user IDs granted unlimited access
BILLING_ENABLED=0                  # 1 to enable paid gating

# --- Dev only ---
# PREVIEW_NO_AUTH=1                 # bypass auth locally (hard-gated to non-production)
